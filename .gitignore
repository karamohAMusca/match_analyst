# Secrets
.env

# Python
__pycache__/
*.pyc
.venv/

# Third-party data: StatsBomb license forbids redistribution of the raw data
references/data/statsbomb/

# Third-party PDFs (FIGC theses): download them from the URLs listed in references/SOURCES.md (not indexed)
references/theses/*.pdf

# Local services data
qdrant_storage/

# FIFA official match reports: public documents, kept locally, not redistributed
references/data/fifa/


# Tooling
.pytest_cache/
.coverage
htmlcov/

# Project guide PDF (not part of the project)
AITHO_Progetto_Personale.pdf
S12_Coding_Agent.pdf

# Personal notes (Italian, not published)
src/LEGGIMI.md

# Local caches (embeddings of the gold questions, ...)
.cache/

# The app's conversations (questions typed by the users): kept locally for analysis
chats/

# Log of the app and the CLI (rotated, see src/observability/logs.py)
logs/

# Design sync (Claude Design): the generated bundle and the tool's own scripts, rebuilt at every sync
design-system/ds-bundle/
design-system/.ds-sync/
design-system/.design-sync/
